# Kopirati u .env i popuniti po potrebi.
# Aplikacija radi i BEZ .env fajla - vrednosti ispod su podrazumevane.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/printing_house_v2
CLIENT_URL=http://localhost:4200

# Tajni kljuc kojim se potpisuju JWT tokeni.
JWT_SECRET=pia-printing-house-razvojni-kljuc
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Posta - slanje PDF fakture klijentu.
#
# Ako se ove vrednosti OSTAVE PRAZNE, koristi se Ethereal: nalog za probu koji
# se pravi sam, bez registracije. Poruka se ne isporucuje nikome nego ostaje na
# njihovom sajtu, a adresa na kojoj se vidi pojavi se u korpi posle potvrde.
#
# Za pravu postu, popuniti SMTP_HOST i SMTP_USER - ostalo se podrazumeva.
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Printing House <faktura@printinghouse.rs>

# ---------------------------------------------------------------------------
# Placanje karticom.
#
# Ako se STRIPE_SECRET_KEY OSTAVI PRAZAN, naplatu resava sam server, sa
# Stripe-ovim zvanicnim brojevima test kartica. Sve radi i bez mreze.
#
# Ako se upise TEST kljuc (pocinje sa sk_test_), ide pravi poziv ka Stripe-u.
# Kljuc se uzima na dashboard.stripe.com/test/apikeys, nalog je besplatan.
# NIKADA ne upisivati pravi (live) kljuc - ovo je projekat, ne prodavnica.
#
# STRIPE_CURRENCY zavisi od zemlje Stripe naloga: nalog otvoren van Srbije
# cesto ne moze da naplati u RSD. Ako Stripe odbije valutu, staviti "eur".
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=rsd
